* text=auto
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.toml text eol=lf
*.txt text eol=lf
*.xml text eol=lf
.env.example text eol=lf
# Frozen evidence uses byte-level SHA-256. Keep its original line endings in Git.
# Never rewrite/normalize working evidence. Targeted Git reindex under -text keeps its bytes.
eval/** -text whitespace=cr-at-eol,-blank-at-eof
examples/** -text whitespace=cr-at-eol,-blank-at-eof
delivery/** -text whitespace=cr-at-eol,-blank-at-eof
docs/08-agent-evaluation.md -text whitespace=cr-at-eol
docs/09-decision-optimization.md -text whitespace=cr-at-eol
docs/10-independent-failure-analysis.md -text whitespace=cr-at-eol
docs/11-live-failure-ledger.md -text whitespace=cr-at-eol
